        isOwner(incoming().userUid) ||
        docId.startsWith(request.auth.uid) ||
        docId.startsWith(getPiUid()) ||
        isAdmin()
      );
    }

    match /fraudSignals/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    match /securityEvents/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    match /invoices/{docId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.buyer.uid) ||
        isOwner(resource.data.buyer.piUid) ||
        isOwner(resource.data.buyerUid) ||
        isOwner(resource.data.seller.ownerUid) ||
        isOwner(resource.data.seller.sellerId) ||
        (resource.data.seller.businessId != null && isBusinessOwner(resource.data.seller.businessId)) ||
        (resource.data.businessId != null && isBusinessOwner(resource.data.businessId)) ||
        (resource.data.seller.businessId != null && isBusinessMember(resource.data.seller.businessId)) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isOwner(incoming().buyer.uid) ||
        isOwner(incoming().buyer.piUid) ||
        isOwner(incoming().buyerUid) ||
        isOwner(incoming().seller.ownerUid) ||
        isOwner(incoming().seller.sellerId) ||
        (incoming().seller.businessId != null && isBusinessOwner(incoming().seller.businessId)) ||
        (incoming().businessId != null && isBusinessOwner(incoming().businessId)) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isOwner(resource.data.buyer.uid) ||
        isOwner(resource.data.seller.ownerUid) ||
        (resource.data.seller.businessId != null && isBusinessOwner(resource.data.seller.businessId)) ||
        (resource.data.businessId != null && isBusinessOwner(resource.data.businessId)) ||
        isAdmin()
      ) && (
        isAdmin() ||
        !incoming().diff(existing()).affectedKeys().hasAny(['invoiceId', 'orderId', 'seller', 'buyer', 'grandTotal', 'subtotal', 'currency'])
      );
      allow delete: if isAdmin();
    }

    match /receipts/{docId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.buyerUid) ||
        isOwner(resource.data.buyer.uid) ||
        isOwner(resource.data.sellerUid) ||
        (resource.data.sellerId != null && isBusinessOwner(resource.data.sellerId)) ||
        (resource.data.businessId != null && isBusinessOwner(resource.data.businessId)) ||
        (resource.data.sellerId != null && isBusinessMember(resource.data.sellerId)) ||
