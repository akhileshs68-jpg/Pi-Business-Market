        isOwner(resource.data.userUid) ||
        isOwner(incoming().userUid) ||
        sessionId.startsWith(request.auth.uid) ||
        sessionId.startsWith(getPiUid()) ||
        isAdmin()
      );
    }

    match /business_verifications/{docId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.applicantUid) ||
        (resource.data.businessId != null && isBusinessOwner(resource.data.businessId)) ||
        (resource.data.businessId != null && isBusinessMember(resource.data.businessId)) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        isOwner(incoming().applicantUid) ||
        (incoming().businessId != null && isBusinessOwner(incoming().businessId)) ||
        (resource != null && isOwner(resource.data.applicantUid)) ||
        (resource != null && resource.data.businessId != null && isBusinessOwner(resource.data.businessId)) ||
        isAdmin()
      );
    }

    match /systemBackups/{docId} {
      allow read, write: if isSuperAdmin() || isAdmin();
    }

    match /accountDeletionRequests/{docId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.userUid) ||
        isOwner(incoming().userUid) ||
        docId.startsWith(request.auth.uid) ||
        docId.startsWith(getPiUid()) ||
        isAdmin()
      );
    }

    match /dataExportRequests/{docId} {
      allow read, write: if isSignedIn() && (
