        isAdmin()
      );
      allow write: if isSignedIn() && (
        isBusinessOwner(incoming().businessId) ||
        (resource != null && isBusinessOwner(resource.data.businessId)) ||
        isAdmin()
      );
    }

    // MODULE 1: DISPUTE SYSTEM SECURITY RULES
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.buyerId) ||
        isOwner(resource.data.userUid) ||
        isOwner(resource.data.sellerId) ||
        (resource.data.businessId != null && isBusinessOwner(resource.data.businessId)) ||
        (resource.data.businessId != null && isBusinessMember(resource.data.businessId)) ||
        isAdmin()
      );
      allow create: if canMutate() && isSignedIn() && (
        isOwner(incoming().buyerId) ||
        isOwner(incoming().userUid) ||
        isOwner(incoming().sellerId) ||
        isAdmin()
      );
      allow update: if canMutate() && isSignedIn() && (
        isAdmin() || (
          (isOwner(existing().buyerId) || isOwner(existing().userUid) || isOwner(existing().sellerId) || (existing().businessId != null && isBusinessOwner(existing().businessId))) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['disputeId', 'orderId', 'buyerId', 'sellerId', 'amount', 'resolution'])
        )
      );
      allow delete: if canMutate() && isAdmin();

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && canMutate();
        allow update, delete: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && canMutate() && (
          incoming().senderUid == request.auth.uid ||
          incoming().senderUid == getPiUid() ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // MODULE 2: BMP TOKEN SYSTEM SECURITY RULES
    match /bmp_wallets/{walletId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.userUid) ||
        isOwner(resource.data.userId) ||
        walletId.startsWith(request.auth.uid) ||
        walletId.startsWith(getPiUid()) ||
        isAdmin()
      );
      allow create: if canMutate() && isSignedIn() && (
        isOwner(incoming().userUid) ||
        isOwner(incoming().userId) ||
        walletId.startsWith(request.auth.uid) ||
        walletId.startsWith(getPiUid()) ||
        isAdmin()
      );
      allow update: if canMutate() && isSignedIn() && (
        isAdmin() || (
          (isOwner(existing().userUid) || isOwner(existing().userId) || walletId.startsWith(request.auth.uid) || walletId.startsWith(getPiUid())) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['balance', 'totalTokens', 'userUid', 'userId', 'stakedTokens'])
        )
      );
      allow delete: if canMutate() && isAdmin();
    }

    match /bmp_ledger/{entryId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isOwner(resource.data.userUid) ||
        isOwner(resource.data.senderUid) ||
        isOwner(resource.data.recipientUid) ||
        isAdmin()
      );
      allow create: if canMutate() && isSignedIn();
      allow update, delete: if isAdmin();
    }

    // MODULE 3: UNIVERSAL APPROVAL SYSTEM SECURITY RULES
    match /universalApprovals/{approvalId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.submittedBy.uid == request.auth.uid ||
        resource.data.submittedBy.uid == getPiUid() ||
        (resource.data.keys().hasAll(['assignedReviewer']) && resource.data.assignedReviewer.uid == request.auth.uid)
      );
      allow create: if canMutate() && isSignedIn() && incoming().submittedBy.uid == request.auth.uid;
      allow update: if canMutate() && isSignedIn() && (
        isAdmin() ||
        (resource.data.keys().hasAll(['assignedReviewer']) && resource.data.assignedReviewer.uid == request.auth.uid && incoming().status in ['Under Review', 'On Hold', 'Approved', 'Rejected', 'Need Changes'])
      );
      allow delete: if canMutate() && isAdmin();
    }

    // MODULE 4: ADMIN SWITCHER SESSION SYSTEM
    match /adminSwitcherSessions/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /approvalAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /approvalNotifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == getPiUid() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
