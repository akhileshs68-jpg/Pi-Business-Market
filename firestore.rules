        isOwner(incoming().sellerUid) ||
        (incoming().sellerId != null && isBusinessOwner(incoming().sellerId)) ||
        (incoming().businessId != null && isBusinessOwner(incoming().businessId)) ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
