rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Gate: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitives
    function isSignedIn() { return request.auth != null; }
    
    // Helper to resolve canonical Pi UID from request auth UID
    function getPiUid() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.piUid
        : request.auth.uid;
    }

    // Secure database-level read-only mode check
    function canMutate() {
      return request.auth == null || 
             !exists(/databases/$(database)/documents/adminSwitcherSessions/$(request.auth.uid)) || 
             get(/databases/$(database)/documents/adminSwitcherSessions/$(request.auth.uid)).data.mode != 'read_only';
    }

    function isOwner(uid) {
      return isSignedIn() && (
        request.auth.uid == uid || 
        getPiUid() == uid
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    /**
     * Validation Blueprint for Enterprise Users
     * Enforces schema integrity, type safety, and immutable identity.
     */
    function isValidUser(data) {
      return (data.keys().hasAll(['pointer']) && data.pointer == true) ||
             (data.keys().hasAll(['uid', 'piUid']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.piUid is string && data.piUid.size() <= 128);
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Super Admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole in ['admin', 'superadmin'] ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'superadmin', 'Admin', 'Super Admin']))
        )) ||
        (exists(/databases/$(database)/documents/users/$(getPiUid())) && (
          get(/databases/$(database)/documents/users/$(getPiUid())).data.role in ['Admin', 'Super Admin'] ||
          get(/databases/$(database)/documents/users/$(getPiUid())).data.platformRole in ['admin', 'superadmin'] ||
          (get(/databases/$(database)/documents/users/$(getPiUid())).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(getPiUid())).data.roles.hasAny(['admin', 'superadmin', 'Admin', 'Super Admin']))
        ))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getPiUid() == 'akhileshs68' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole == 'superadmin' ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['superadmin', 'Super Admin']))
        )) ||
        (exists(/databases/$(database)/documents/users/$(getPiUid())) && (
          get(/databases/$(database)/documents/users/$(getPiUid())).data.role == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(getPiUid())).data.platformRole == 'superadmin' ||
          (get(/databases/$(database)/documents/users/$(getPiUid())).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(getPiUid())).data.roles.hasAny(['superadmin', 'Super Admin']))
        ))
      );
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || 
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == getPiUid()
      );
    }

    function isBusinessMember(businessId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + request.auth.uid)) ||
        exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + getPiUid()))
      );
    }

    function hasBusinessRole(businessId, roles) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + request.auth.uid)) && 
         get(/databases/$(database)/documents/businessMembers/$(businessId + "_" + request.auth.uid)).data.role in roles) ||
        (exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + getPiUid())) && 
         get(/databases/$(database)/documents/businessMembers/$(businessId + "_" + getPiUid())).data.role in roles)
      );
    }

    // 3. Collection Rules
    match /users/{uid} {
      allow read: if true;
      allow create, update: if true;
    }

    // New Business Identity Rules
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if canMutate() && isSignedIn() && (resource == null || isOwner(incoming().ownerUid) || incoming().ownerUid == request.auth.uid);
      allow update: if canMutate() && isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBusinessOwner(businessId) || hasBusinessRole(businessId, ['Super Admin', 'Business Admin']) || isAdmin());
      allow delete: if canMutate() && isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBusinessOwner(businessId) || isSuperAdmin() || isAdmin());
    }

    match /businessMembers/{memberId} {
      allow read: if isSignedIn() && (
        resource.data.userUid == request.auth.uid || 
        isOwner(resource.data.userUid) || 
        (resource.data.keys().hasAll(['businessId']) && isBusinessMember(resource.data.businessId)) || 
        isAdmin()
      );
      allow create: if isSignedIn(); // Usually via transaction or invite
      allow update, delete: if isSignedIn() && (
        resource.data.userUid == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) || 
        hasBusinessRole(resource.data.businessId, ['Super Admin', 'Business Admin', 'HR'])
      );
    }

    match /businessInvitations/{invitationId} {
      allow read: if isSignedIn() && (isBusinessMember(resource.data.businessId) || incoming().email == request.auth.token.email);
      allow create: if isSignedIn() && hasBusinessRole(incoming().businessId, ['Owner', 'Super Admin', 'Business Admin', 'HR']);
      allow update: if isSignedIn(); // Accept/Reject
      allow delete: if isSignedIn() && hasBusinessRole(resource.data.businessId, ['Owner', 'Super Admin', 'Business Admin', 'HR']);
    }

    match /businessDocuments/{docId} {
      allow read: if isSignedIn() && (isBusinessMember(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn() && isBusinessMember(incoming().businessId);
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || hasBusinessRole(resource.data.businessId, ['Super Admin', 'Business Admin']));
    }

    match /businessAuditLogs/{logId} {
      allow read: if isSignedIn() && (isBusinessMember(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if false; // Append-only
    }

    match /businessCategories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessSettings/{businessId} {
      allow read: if isSignedIn() && isBusinessMember(businessId);
      allow write: if isSignedIn() && (isBusinessOwner(businessId) || hasBusinessRole(businessId, ['Super Admin', 'Business Admin']));
    }

    // Legacy/Compatibility support for existing modules
    match /businessProfiles/{businessId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(incoming().ownerUid) && incoming().businessId == businessId;
      allow update, delete: if isSignedIn() && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if canMutate() && isSignedIn();
      allow update, delete: if canMutate() && isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isOwner(resource.data.userId) || 
        isOwner(resource.data.sellerId) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isAdmin()
      );
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if canMutate() && isSignedIn();
      allow update, delete: if canMutate() && isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isOwner(resource.data.sellerId) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if canMutate() && isSignedIn();
      allow update: if canMutate() && isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isOwner(resource.data.sellerId) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']))
      );
      allow delete: if canMutate() && isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isOwner(resource.data.sellerId) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
    }

    match /carts/{cartId} {
      allow read: if isSignedIn() && (
        resource.data.userUid == request.auth.uid || 
        isOwner(resource.data.userUid) || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().userUid == request.auth.uid || 
        isOwner(incoming().userUid) || 
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userUid == request.auth.uid || 
        isOwner(resource.data.userUid) || 
        isAdmin()
      );
    }

    match /cartItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /wishlists/{wishlistId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isOwner(resource.data.userUid) || 
        isOwner(incoming().userUid) || 
        isAdmin()
      );
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.buyerId) || 
        isOwner(resource.data.sellerId) || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isOwner(resource.data.buyerId) || 
        isOwner(resource.data.sellerId) || 
        isAdmin()
      );
    }

    match /shipments/{shipmentId} {
      allow read, write: if isSignedIn();
    }

    match /packages/{packageId} {
      allow read, write: if isSignedIn();
    }

    match /trackingEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /store_categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /store_inventory_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /variantGroups/{groupId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /variantOptions/{optionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /loyaltyTransactions/{txId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userUid) || isAdmin());
      allow create: if isSignedIn();
    }

    match /systemAnnouncements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Analytics & BI
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn(); // Events are append-only
      allow read: if isAdmin();
    }

    match /businessMetrics/{metricId} {
      allow read: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
      allow write: if false; // Only system-triggered via functions or batch (simulated)
    }

    match /systemMetrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 5. Audit & Governance
    match /auditLogs/{logId} {
      allow create: if isSignedIn(); // Log entry creation
      allow read: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /maintenanceWindows/{windowId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Commerce & OMS
    match /checkoutSessions/{sessionId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.buyerId) || 
        isOwner(resource.data.userUid) || 
        isOwner(resource.data.sellerId) || 
        isOwner(incoming().buyerId) || 
        isOwner(incoming().userUid) || 
        isOwner(incoming().sellerId) || 
        isAdmin()
      );
    }

    match /orderDrafts/{draftId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.buyerId) || 
        isOwner(resource.data.userUid) || 
        isOwner(incoming().buyerId) || 
        isOwner(incoming().userUid) || 
        isAdmin()
      );
    }

    match /userAddresses/{addressId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userUid) || 
        isOwner(incoming().userUid) || 
        isAdmin()
      );
    }

    match /orders/{orderId} {
      allow read: if true;
      allow write: if canMutate();
    }

    match /wallets/{walletId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userId) || 
        isOwner(incoming().userId) || 
        walletId.startsWith(request.auth.uid + "_") ||
        walletId.startsWith(getPiUid() + "_") ||
        isAdmin() ||
        (incoming().userId == (resource == null ? incoming().userId : resource.data.userId) &&
         incoming().balance >= (resource == null ? 0.0 : resource.data.balance))
      );
    }

    match /wallet_transactions/{txId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userId) || 
        isOwner(incoming().userId) || 
        isAdmin() ||
        (incoming().type == 'CREDIT')
      );
    }

    match /master_wallets/{walletId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userId) || 
        isOwner(incoming().userId) || 
        isAdmin() ||
        (incoming().userId == (resource == null ? incoming().userId : resource.data.userId) &&
         incoming().piTestnetBalance >= (resource == null ? 0.0 : resource.data.piTestnetBalance))
      );
    }

    match /master_ledger/{ledgerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /ledger_entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /user_gamification/{docId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userUid) || 
        isOwner(incoming().userUid) || 
        isAdmin()
      );
    }

    match /user_active_pioneer/{docId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userUid) || 
        isOwner(incoming().userUid) || 
        isAdmin()
      );
    }

    match /merchantSettlements/{docId} {
      allow read: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.userUid) || 
        isOwner(resource.data.sellerId) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.userUid) || 
        isOwner(resource.data.sellerId) || 
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /orderItems/{itemId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.buyerId) || 
        isOwner(resource.data.userUid) || 
        isOwner(resource.data.sellerId) || 
        isOwner(incoming().buyerId) || 
        isOwner(incoming().userUid) || 
        isOwner(incoming().sellerId) || 
        isAdmin()
      );
    }

    match /orderTimeline/{eventId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.buyerId) || 
        isOwner(resource.data.userUid) || 
        isOwner(resource.data.sellerId) || 
        isOwner(incoming().buyerId) || 
        isOwner(incoming().userUid) || 
        isOwner(incoming().sellerId) || 
        isAdmin()
      );
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.uid) || 
        isOwner(resource.data.userId) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
      allow create: if canMutate() && isSignedIn() && (
        isOwner(incoming().uid) || 
        isOwner(incoming().userId)
      );
      allow update: if canMutate() && isSignedIn() && (
        isOwner(resource.data.uid) || 
        isOwner(resource.data.userId) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
      allow delete: if canMutate() && isAdmin();
    }

    match /paymentHistory/{historyId} {
      allow read: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.uid) || 
        isOwner(resource.data.userId) || 
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /notificationPreferences/{userUid} {
      allow read, write: if true;
    }

    match /conversations/{convId} {
      allow read, create, update, delete: if isSignedIn();
      
      match /messages/{msgId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && isBusinessOwner(incoming().businessId);
      allow update: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
      allow delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /jobApplications/{appId} {
      allow read: if isSignedIn() && (isOwner(resource.data.candidateId) || isBusinessOwner(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /candidateProfiles/{profileId} {
      allow read: if true;
      allow write: if isOwner(resource.data.userUid) || isOwner(incoming().userUid);
    }

    match /inventory/{invId} {
      allow read: if true;
      allow write: if isSignedIn() && (isBusinessOwner(incoming().businessId) || isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /inventoryTransactions/{txId} {
      allow read: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn();
    }

    match /searchIndex/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.reviewerUid) || isAdmin());
    }

    match /reputationScores/{entityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /advertisements/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /follows/{followId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviewVotes/{voteId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /media/{mediaId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        resource.data.visibility == 'public' || 
        isAdmin() ||
        (resource.data.businessId != null && isBusinessMember(resource.data.businessId))
      );
      allow create: if isSignedIn() && isOwner(incoming().ownerUid);
      allow update, delete: if isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isAdmin() ||
        (resource.data.businessId != null && hasBusinessRole(resource.data.businessId, ['Super Admin', 'Business Admin']))
      );
    }

    match /identities/{identityId} {
      allow read, write: if isSignedIn();
    }

    match /loyaltyAccounts/{accountId} {
      allow read, write: if isSignedIn();
    }

    match /loyaltyTransactions/{txId} {
      allow read, write: if isSignedIn();
    }

    match /securitySessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /business_verifications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /systemBackups/{docId} {
      allow read, write: if isSignedIn();
    }

    match /accountDeletionRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /dataExportRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /privacyConsents/{docId} {
      allow read, write: if isSignedIn();
    }

    match /fraudSignals/{docId} {
      allow read, write: if isSignedIn();
    }

    match /securityEvents/{docId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{docId} {
      allow read, write: if isSignedIn();
    }

    match /receipts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /attributeGroups/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /attributes/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categoryAttributes/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /customerNotes/{docId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{docId} {
      allow read, write: if isSignedIn();
    }

    match /customerTimeline/{docId} {
      allow read, write: if isSignedIn();
    }

    match /share_events/{docId} {
      allow read, write: if isSignedIn();
    }

    match /share_clicks/{docId} {
      allow read, write: if isSignedIn();
    }

    match /blockedUsers/{docId} {
      allow read, write: if isSignedIn();
    }

    match /reportedConversations/{docId} {
      allow read, write: if isSignedIn();
    }

    match /reviewReports/{docId} {
      allow read, write: if isSignedIn();
    }

    match /anti_cheat_audit_logs/{docId} {
      allow read, write: if isSignedIn();
    }

    match /recentSearches/{docId} {
      allow read, write: if isSignedIn();
    }

    match /serviceAvailability/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /servicePackages/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userWishlists/{docId} {
      allow read, write: if isSignedIn();
    }

    match /warehouseLocations/{docId} {
      allow read, write: if isSignedIn();
    }

    match /warehouses/{docId} {
      allow read, write: if isSignedIn();
    }

    // MODULE 1: DISPUTE SYSTEM SECURITY RULES
    match /disputes/{disputeId} {
      allow read: if true;
      allow write: if canMutate();

      match /events/{eventId} {
        allow read: if true;
        allow write: if canMutate();
      }

      match /messages/{messageId} {
        allow read: if true;
        allow write: if canMutate();
      }
    }

    // MODULE 2: BMP TOKEN SYSTEM SECURITY RULES
    match /bmp_wallets/{walletId} {
      allow read: if true;
      allow write: if canMutate();
    }

    match /bmp_ledger/{entryId} {
      allow read: if true;
      allow write: if canMutate();
    }

    // MODULE 3: UNIVERSAL APPROVAL SYSTEM SECURITY RULES
    match /universalApprovals/{approvalId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.submittedBy.uid == request.auth.uid ||
        resource.data.submittedBy.uid == getPiUid() ||
        (resource.data.keys().hasAll(['assignedReviewer']) && resource.data.assignedReviewer.uid == request.auth.uid)
      );
      allow create: if canMutate() && isSignedIn() && incoming().submittedBy.uid == request.auth.uid;
      allow update: if canMutate() && isSignedIn() && (
        isAdmin() ||
        (resource.data.keys().hasAll(['assignedReviewer']) && resource.data.assignedReviewer.uid == request.auth.uid && incoming().status in ['Under Review', 'On Hold', 'Approved', 'Rejected', 'Need Changes'])
      );
      allow delete: if canMutate() && isAdmin();
    }

    // MODULE 4: ADMIN SWITCHER SESSION SYSTEM
    match /adminSwitcherSessions/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /approvalAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /approvalNotifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == getPiUid() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
