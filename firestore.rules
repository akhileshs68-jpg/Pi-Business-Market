rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Gate: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitives
    function isSignedIn() { return request.auth != null; }
    
    // Helper to resolve canonical Pi UID from request auth UID
    function getPiUid() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.piUid
        : request.auth.uid;
    }

    function isOwner(uid) {
      return isSignedIn() && (
        request.auth.uid == uid || 
        getPiUid() == uid
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    /**
     * Validation Blueprint for Enterprise Users
     * Enforces schema integrity, type safety, and immutable identity.
     */
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'piUid', 'username', 'accountType', 'status']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.piUid is string && data.piUid.size() <= 128 &&
             data.username is string && data.username.size() <= 128 &&
             data.accountType in ['individual', 'business', 'enterprise'] &&
             data.status in ['active', 'suspended', 'pending_verification'];
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Super Admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole in ['admin', 'superadmin'] ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'superadmin', 'Admin', 'Super Admin']))
        )) ||
        (exists(/databases/$(database)/documents/users/$(getPiUid())) && (
          get(/databases/$(database)/documents/users/$(getPiUid())).data.role in ['Admin', 'Super Admin'] ||
          get(/databases/$(database)/documents/users/$(getPiUid())).data.platformRole in ['admin', 'superadmin'] ||
          (get(/databases/$(database)/documents/users/$(getPiUid())).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(getPiUid())).data.roles.hasAny(['admin', 'superadmin', 'Admin', 'Super Admin']))
        ))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getPiUid() == 'akhileshs68' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole == 'superadmin' ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['superadmin', 'Super Admin']))
        )) ||
        (exists(/databases/$(database)/documents/users/$(getPiUid())) && (
          get(/databases/$(database)/documents/users/$(getPiUid())).data.role == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(getPiUid())).data.platformRole == 'superadmin' ||
          (get(/databases/$(database)/documents/users/$(getPiUid())).data.keys().hasAll(['roles']) && 
           get(/databases/$(database)/documents/users/$(getPiUid())).data.roles.hasAny(['superadmin', 'Super Admin']))
        ))
      );
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || 
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == getPiUid()
      );
    }

    function isBusinessMember(businessId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + request.auth.uid)) ||
        exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + getPiUid()))
      );
    }

    function hasBusinessRole(businessId, roles) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + request.auth.uid)) && 
         get(/databases/$(database)/documents/businessMembers/$(businessId + "_" + request.auth.uid)).data.role in roles) ||
        (exists(/databases/$(database)/documents/businessMembers/$(businessId + "_" + getPiUid())) && 
         get(/databases/$(database)/documents/businessMembers/$(businessId + "_" + getPiUid())).data.role in roles)
      );
    }

    // 3. Collection Rules
    match /users/{uid} {
      allow get: if isOwner(uid) || (isSignedIn() && (request.auth.uid == resource.data.firebaseUid || request.auth.uid == resource.data.lastResolvedUid)) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(uid) || (isSignedIn() && (request.auth.uid == incoming().firebaseUid || request.auth.uid == incoming().lastResolvedUid))) && isValidUser(incoming());
      allow update: if (isOwner(uid) || (isSignedIn() && (request.auth.uid == existing().firebaseUid || request.auth.uid == existing().lastResolvedUid))) && 
                    isValidUser(incoming());
    }

    // New Business Identity Rules
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (isBusinessOwner(businessId) || hasBusinessRole(businessId, ['Super Admin', 'Business Admin']));
      allow delete: if isSignedIn() && (isBusinessOwner(businessId) || isSuperAdmin());
    }

    match /businessMembers/{memberId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isBusinessMember(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn(); // Usually via transaction or invite
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || hasBusinessRole(resource.data.businessId, ['Super Admin', 'Business Admin', 'HR']));
    }

    match /businessInvitations/{invitationId} {
      allow read: if isSignedIn() && (isBusinessMember(resource.data.businessId) || incoming().email == request.auth.token.email);
      allow create: if isSignedIn() && hasBusinessRole(incoming().businessId, ['Owner', 'Super Admin', 'Business Admin', 'HR']);
      allow update: if isSignedIn(); // Accept/Reject
      allow delete: if isSignedIn() && hasBusinessRole(resource.data.businessId, ['Owner', 'Super Admin', 'Business Admin', 'HR']);
    }

    match /businessDocuments/{docId} {
      allow read: if isSignedIn() && (isBusinessMember(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn() && isBusinessMember(incoming().businessId);
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || hasBusinessRole(resource.data.businessId, ['Super Admin', 'Business Admin']));
    }

    match /businessAuditLogs/{logId} {
      allow read: if isSignedIn() && (isBusinessMember(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if false; // Append-only
    }

    match /businessCategories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessSettings/{businessId} {
      allow read: if isSignedIn() && isBusinessMember(businessId);
      allow write: if isSignedIn() && (isBusinessOwner(businessId) || hasBusinessRole(businessId, ['Super Admin', 'Business Admin']));
    }

    // Legacy/Compatibility support for existing modules
    match /businessProfiles/{businessId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == incoming().ownerUid && incoming().businessId == businessId;
      allow update, delete: if isSignedIn() && (request.auth.uid == existing().ownerUid || isAdmin());
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']))
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
    }

    match /carts/{cartId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /cartItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /wishlists/{wishlistId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /shipments/{shipmentId} {
      allow read, write: if isSignedIn();
    }

    match /packages/{packageId} {
      allow read, write: if isSignedIn();
    }

    match /trackingEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /store_categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /store_inventory_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /variantGroups/{groupId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /variantOptions/{optionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /loyaltyTransactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /systemAnnouncements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Analytics & BI
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn(); // Events are append-only
      allow read: if isAdmin();
    }

    match /businessMetrics/{metricId} {
      allow read: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
      allow write: if false; // Only system-triggered via functions or batch (simulated)
    }

    match /systemMetrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 5. Audit & Governance
    match /auditLogs/{logId} {
      allow create: if isSignedIn(); // Log entry creation
      allow read: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /maintenanceWindows/{windowId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Commerce & OMS
    match /checkoutSessions/{sessionId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.userUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        incoming().buyerId == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        incoming().sellerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /orderDrafts/{draftId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.userUid == request.auth.uid || 
        incoming().buyerId == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /userAddresses/{addressId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.userUid == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.businessId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        resource == null ||
        incoming().buyerId == request.auth.uid ||
        incoming().userUid == request.auth.uid ||
        incoming().sellerId == request.auth.uid ||
        incoming().businessId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.userUid == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.businessId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
    }

    match /wallets/{walletId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        incoming().userId == request.auth.uid ||
        walletId.startsWith(request.auth.uid + "_") ||
        isAdmin() ||
        (incoming().userId == (resource == null ? incoming().userId : resource.data.userId) &&
         incoming().balance >= (resource == null ? 0.0 : resource.data.balance))
      );
    }

    match /wallet_transactions/{txId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        incoming().userId == request.auth.uid || 
        isAdmin() ||
        (incoming().type == 'CREDIT')
      );
    }

    match /master_wallets/{walletId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        incoming().userId == request.auth.uid || 
        isAdmin() ||
        (incoming().userId == (resource == null ? incoming().userId : resource.data.userId) &&
         incoming().piTestnetBalance >= (resource == null ? 0.0 : resource.data.piTestnetBalance))
      );
    }

    match /master_ledger/{ledgerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /ledger_entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /user_gamification/{docId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /user_active_pioneer/{docId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /merchantSettlements/{docId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /orderItems/{itemId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.userUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        incoming().buyerId == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        incoming().sellerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /orderTimeline/{eventId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.userUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        incoming().buyerId == request.auth.uid || 
        incoming().userUid == request.auth.uid || 
        incoming().sellerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.uid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().uid == request.auth.uid || 
        incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid) || 
        isBusinessOwner(resource.data.businessId) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /paymentHistory/{historyId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.uid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn(); // Can be system or user
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    match /notificationPreferences/{userUid} {
      allow read, write: if isOwner(userUid);
    }

    match /conversations/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      match /messages/{msgId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && isBusinessOwner(incoming().businessId);
      allow update: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
      allow delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /jobApplications/{appId} {
      allow read: if isSignedIn() && (resource.data.candidateId == request.auth.uid || isBusinessOwner(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /candidateProfiles/{profileId} {
      allow read: if true;
      allow write: if isOwner(resource.data.userUid || incoming().userUid);
    }

    match /inventory/{invId} {
      allow read: if true;
      allow write: if isSignedIn() && (isBusinessOwner(incoming().businessId) || isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /inventoryTransactions/{txId} {
      allow read: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
      allow create: if isSignedIn();
    }

    match /searchIndex/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.reviewerUid || isAdmin());
    }

    match /reputationScores/{entityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isSignedIn() && (isBusinessOwner(incoming().businessId) || isAdmin());
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isSignedIn() && (isBusinessOwner(incoming().businessId) || isAdmin());
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /advertisements/{adId} {
      allow read: if true;
      allow create: if isSignedIn() && (isBusinessOwner(incoming().businessId) || isAdmin());
      allow update, delete: if isSignedIn() && (isBusinessOwner(resource.data.businessId) || isAdmin());
    }

    match /follows/{followId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviewVotes/{voteId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /media/{mediaId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.visibility == 'public' || 
        isAdmin() ||
        (resource.data.businessId != null && isBusinessMember(resource.data.businessId))
      );
      allow create: if isSignedIn() && incoming().ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        isAdmin() ||
        (resource.data.businessId != null && hasBusinessRole(resource.data.businessId, ['Super Admin', 'Business Admin']))
      );
    }

    match /identities/{identityId} {
      allow read, write: if isSignedIn();
    }

    match /loyaltyAccounts/{accountId} {
      allow read, write: if isSignedIn();
    }

    match /loyaltyTransactions/{txId} {
      allow read, write: if isSignedIn();
    }

    match /securitySessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /business_verifications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /systemBackups/{docId} {
      allow read, write: if isSignedIn();
    }

    match /accountDeletionRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /dataExportRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /privacyConsents/{docId} {
      allow read, write: if isSignedIn();
    }

    match /fraudSignals/{docId} {
      allow read, write: if isSignedIn();
    }

    match /securityEvents/{docId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{docId} {
      allow read, write: if isSignedIn();
    }

    match /receipts/{docId} {
      allow read, write: if isSignedIn();
    }

